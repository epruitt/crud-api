@URL = https://hlfmtja7r6.execute-api.us-east-2.amazonaws.com/


### Get all users
GET {{URL}}/users

### Create a user
POST {{URL}}/users
Content-Type: application/json

{
    "name": "John Jones",
    "email": "john.jones@example.com"
}

### Get a user
GET {{URL}}/users/ea1e0d0-c5d2-43be-ad06-07847771eb69

### Update a user
PUT {{URL}}/users/ea1e0d0-c5d2-43be-ad06-07847771eb69
Content-Type: application/json

{
    "name": "coding addict",
    "email": "coding@addict.com"
}

### Delete a user
DELETE {{URL}}/users/ea1e0d0-c5d2-43be-ad06-07847771eb69